# Copy to .env (gitignored) — never commit real secrets
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the frontend callback & the GitHub OAuth App setting
GITHUB_REDIRECT_URI=http://localhost:4200/auth/github/callback
GITHUB_SUCCESS_REDIRECT=http://localhost:4200/account?github=connected
GITHUB_FAILURE_REDIRECT=http://localhost:4200/account?github=error
GITHUB_OAUTH_SCOPES=read:user,repo,user:email
