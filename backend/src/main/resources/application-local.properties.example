# Running the backend natively (mvn spring-boot:run -Dspring-boot.run.profiles=local) against local Postgres.
# Copy to application-local.properties in this folder (gitignored) and fill in only what you need.
# Every key is the same environment variable the containers use; see application.properties for defaults.
#
# Outside Docker, use the public hostnames below, not http://portainer:9000 or http://npm:81
# (those only resolve inside the Mini PC's Docker network).

# CORS for `ng serve` on :4200
CLOUDBASE_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Portainer
PORTAINER_URL=https://manage.cloudbase.website
PORTAINER_API_KEY=ptr_xxxxxxxx
PORTAINER_ENDPOINT_ID=3

# Nginx Proxy Manager
NPM_ENABLED=true
NPM_URL=https://npm.cloudbase.website
NPM_EMAIL=your_npm_email@example.com
NPM_PASSWORD=your_npm_password
NPM_CERTIFICATE_ID=14

# Docker Hub
DOCKER_HUB_USERNAME=minipcer
DOCKER_HUB_TOKEN=dckr_pat_xxxxxxxx
CLOUDBASE_DOCKERHUB_NAMESPACE=minipcer

# Platform
CLOUDBASE_BASE_DOMAIN=cloudbase.website
CLOUDBASE_DOCKER_NETWORK=cloudbase

# Resend email (optional)
RESEND_ENABLED=true
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=CloudBase <noreply@mawrid.cloudbase.website>
RESEND_DOMAIN=mawrid.cloudbase.website
RESEND_ADMIN_NOTIFY=you@example.com
APP_BASE_URL=http://localhost:4200
