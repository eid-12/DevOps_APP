# Local development with `docker compose up` (docker-compose.yml). Copy to .env (never commit).
# Generate secrets with: openssl rand -hex 48

# Required
DB_PASS=
JWT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Optional: first admin account, created on first start if no admin exists
CLOUDBASE_BOOTSTRAP_ADMIN_EMAIL=
CLOUDBASE_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: real integrations (leave empty to run without them)
PORTAINER_URL=
PORTAINER_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Production variables are in deploy/.env.example.
