# Local development with `docker compose up` (docker-compose.yml). Copy to .env (never commit).
# Generate secrets with: openssl rand -hex 48

# Required
DB_PASS=
JWT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Optional: first admin account, created on first start if no admin exists
CLOUDBASE_BOOTSTRAP_ADMIN_EMAIL=
CLOUDBASE_BOOTSTRAP_ADMIN_PASSWORD=

# Optional: real integrations. Empty = run without them. Use local or sandbox values only, never production ones.
PORTAINER_URL=
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=
NPM_ENABLED=false
NPM_URL=
NPM_EMAIL=
NPM_PASSWORD=
NPM_CERTIFICATE_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
GITHUB_SUCCESS_REDIRECT=

# Optional: only set to override the Compose defaults
CLOUDBASE_BASE_DOMAIN=
CLOUDBASE_DOCKER_NETWORK=
CLOUDBASE_DOCKERHUB_NAMESPACE=
CLOUDBASE_PUBLIC_API_URL=
CLOUDBASE_CORS_ALLOWED_ORIGINS=

# Production values live in the Portainer stack environment (template: deploy/.env.example). Do not copy them here.
