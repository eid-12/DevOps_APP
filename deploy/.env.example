# Production stack variables (Portainer stack env). For a manual run, copy to deploy/.env (never commit).
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

DB_PASS=
JWT_SECRET=
GITHUB_WEBHOOK_SECRET=

PORTAINER_URL=https://manage.cloudbase.website
PORTAINER_API_KEY=
PORTAINER_ENDPOINT_ID=3

NPM_ENABLED=true
NPM_URL=https://npm.cloudbase.website
NPM_EMAIL=
NPM_PASSWORD=
NPM_CERTIFICATE_ID=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://www.cloudbase.website/auth/github/callback
GITHUB_SUCCESS_REDIRECT=https://www.cloudbase.website/account?github=connected
GITHUB_FAILURE_REDIRECT=https://www.cloudbase.website/account?github=error
APP_BASE_URL=https://www.cloudbase.website

CLOUDBASE_BASE_DOMAIN=cloudbase.website
CLOUDBASE_PUBLIC_API_URL=https://api.cloudbase.website
# Exact browser origins for /api and /ws (comma-separated, no wildcards). Defaults to www + apex.
# CLOUDBASE_CORS_ALLOWED_ORIGINS=https://www.cloudbase.website,https://cloudbase.website
CLOUDBASE_DOCKER_NETWORK=cloudbase

CLOUDBASE_BOOTSTRAP_ADMIN_EMAIL=
CLOUDBASE_BOOTSTRAP_ADMIN_PASSWORD=

RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_FROM=CloudBase <noreply@mawrid.cloudbase.website>
