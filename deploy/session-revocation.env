# Session revocation (users.session_version, claim "sv") and automatic rollback. Read by deploy/portainer-deploy.sh
# and .github/workflows/ci-cd.yml. Values are commit SHAs, nothing secret.
#
# First main-line commit whose backend enforces "sv". Any backend built from it or a descendant is a safe rollback
# target; an older backend would accept tokens that a password change or reset had revoked.
SESSION_REVOCATION_SINCE=7311725d6b579e080f6e24065e7015949f58578a
# Rollback build for when the deployed backend predates that commit: branch rollback/1b885e9-sv (1b885e9 plus sv
# revocation only). CI publishes it with every release so the deploy script can roll back to it by digest.
# Remove this line once production runs 7311725 or later: from then on the previous release is safe itself.
ROLLBACK_COMPAT_SHA=8055fa4ae3cd0cc11cb391ac0c43f979308ead78
